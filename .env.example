# SellerSprite open-source MCP: local logged-in Chromium session.
SELLERSPRITE_CDP_URL=http://127.0.0.1:9222

# SIF MCP. Current community integrations commonly use `secret-key`.
# If your account uses a different header, change only these env values.
SIF_MCP_URL=https://mcp.sif.com/mcp
SIF_MCP_AUTH_HEADER=secret-key
SIF_MCP_AUTH_SCHEME=
SIF_MCP_TOKEN=

# 西柚洞察 MCP
XIYOU_MCP_URL=https://mcp.xydc.com/mcp
XIYOU_MCP_AUTH_HEADER=Authorization
XIYOU_MCP_AUTH_SCHEME=Bearer
XIYOU_MCP_TOKEN=

# Apify official Streamable HTTP MCP
APIFY_MCP_URL=https://mcp.apify.com
APIFY_MCP_AUTH_HEADER=Authorization
APIFY_MCP_AUTH_SCHEME=Bearer
APIFY_TOKEN=

# Optional hosted SellerSprite endpoint if customer later provides one.
SELLERSPRITE_MCP_URL=
SELLERSPRITE_MCP_AUTH_HEADER=Authorization
SELLERSPRITE_MCP_AUTH_SCHEME=Bearer
SELLERSPRITE_MCP_TOKEN=

# Experimental local-only state API; start/resume does not execute research.
# Inject a private operator token via the environment (never commit it).
RESEARCH_API_TOKEN=
